# =============================================
# Server
# =============================================
NODE_ENV=development
PORT=3000

# =============================================
# Nhà hàng (cố định — hệ thống phục vụ 1 nhà hàng)
# =============================================
RESTAURANT_ID=1

# =============================================
# Database (khớp với docker-compose.yml)
# =============================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=quanlynhahang
DB_CONNECTION_LIMIT=10

# =============================================
# JWT — THAY ĐỔI TRƯỚC KHI DEPLOY PRODUCTION!
# =============================================
JWT_SECRET=change_this_super_secret_key_in_production_min_32_chars
JWT_EXPIRES_IN=8h

# =============================================
# Bcrypt
# =============================================
BCRYPT_SALT_ROUNDS=12

# =============================================
# VNPay Sandbox (API v2.1.0 - HMACSHA512)
# Đăng ký tài khoản Sandbox tại: https://sandbox.vnpayment.vn/devreg/
# Tuyệt đối KHÔNG commit secret thật lên Git!
# =============================================
VNP_TMN_CODE=YOUR_SANDBOX_TMN_CODE
VNP_HASH_SECRET=YOUR_SANDBOX_HASH_SECRET
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNP_RETURN_URL=http://localhost:3000/api/payments/vnpay/return
VNP_IPN_URL=https://your-https-tunnel-or-cloud-domain/api/payments/vnpay/ipn
VNP_FRONTEND_RETURN_URL=http://localhost:5173/customer/payment-result
VNP_PENDING_TIMEOUT_MINUTES=15

# =============================================
# VietQR & SePay (Ngân hàng MB Bank - VA VQRQANXJH4626)
# =============================================
VIETQR_BANK_ID=MBBank
VIETQR_ACCOUNT_NO=VQRQANXJH4626
VIETQR_ACCOUNT_NAME=LE QUANG HUY
SEPAY_WEBHOOK_API_KEY=BBQ_KLTN_SEPAY_2026_2027
