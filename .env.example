# =============================================
# Server
# =============================================
NODE_ENV=development
PORT=3000

# =============================================
# Nhà hàng (cố định — hệ thống phục vụ 1 nhà hàng)
# =============================================
RESTAURANT_ID=1

# =============================================
# Database (khớp với docker-compose.yml)
# =============================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=quanlynhahang
DB_CONNECTION_LIMIT=10

# =============================================
# JWT — THAY ĐỔI TRƯỚC KHI DEPLOY PRODUCTION!
# =============================================
JWT_SECRET=change_this_super_secret_key_in_production_min_32_chars
JWT_EXPIRES_IN=8h

# =============================================
# Bcrypt
# =============================================
BCRYPT_SALT_ROUNDS=12
